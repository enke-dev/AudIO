    "Starting… if macOS asks, allow system audio recording": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spouští se… pokud se macOS zeptá, povolte nahrávání systémového zvuku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter… hvis macOS spørger, så tillad optagelse af systemlyd"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten … wenn macOS fragt, erlaube die Aufnahme des Systemaudios"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting… if macOS asks, allow system audio recording"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciando… si macOS lo pide, permite la grabación del audio del sistema"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistetään… jos macOS kysyy, salli järjestelmä­äänen tallennus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrage… si macOS le demande, autorisez l’enregistrement de l’audio système"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvio… se macOS lo chiede, consenti la registrazione dell’audio di sistema"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動中… macOSから確認された場合は、システムオーディオの録音を許可してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하는 중… macOS가 물으면 시스템 오디오 녹음을 허용하십시오"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter … hvis macOS spør, tillat opptak av systemlyd"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten… als macOS erom vraagt, sta opname van systeemaudio toe"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamianie… jeśli macOS zapyta, zezwól na nagrywanie dźwięku systemowego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciando… se o macOS pedir, permita a gravação do áudio do sistema"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Startar… om macOS frågar, tillåt inspelning av systemljud"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запуск… якщо macOS запитає, дозвольте запис системного аудіо"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动… 如果 macOS 询问，请允许录制系统音频"
          }
        }
      }
    },
    "The downloaded app isn’t signed like this one – not installed.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stažená aplikace není podepsána stejně jako tato – nenainstalováno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den hentede app er ikke signeret som denne – ikke installeret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geladene App ist nicht wie diese signiert – nicht installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded app isn’t signed like this one – not installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app descargada no está firmada como esta – no se ha instalado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladattua appia ei ole allekirjoitettu kuten tätä – ei asennettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app téléchargée n’est pas signée comme celle-ci – non installée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app scaricata non è firmata come questa – non installata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたAppはこのAppと同じ署名ではありません – インストールしませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 앱이 이 앱과 같이 서명되지 않았습니다 – 설치하지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nedlastede appen er ikke signert som denne – ikke installert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gedownloade app is niet zo ondertekend als deze – niet geïnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrana aplikacja nie jest podpisana tak jak ta – nie zainstalowano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app baixado não está assinado como este – não instalado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den hämtade appen är inte signerad som den här – inte installerad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажену програму підписано не так, як цю – не встановлено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的 App 与此 App 的签名不同 – 未安装。"
          }
        }
      }
    },
