    "No test tone detected from %@ – turn it up and keep the room quiet": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z %@ nebyl zachycen testovací tón – zesilte a udržujte ticho"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen testtone registreret fra %@ – skru op og hold rummet stille"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Testton von %@ erkannt – lauter stellen und für Ruhe sorgen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No test tone detected from %@ – turn it up and keep the room quiet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectó ningún tono de prueba de %@ – sube el volumen y mantén el silencio"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testiääntä ei havaittu kohteesta %@ – lisää äänenvoimakkuutta ja pidä huone hiljaisena"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun signal de test détecté de %@ – montez le volume et gardez le silence"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tono di prova rilevato da %@ – alza il volume e mantieni silenzio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@からテストトーンを検出できません – 音量を上げ、静かにしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 테스트 톤이 감지되지 않았습니다 – 음량을 높이고 조용히 해 주십시오"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen testtone registrert fra %@ – skru opp og hold rommet stille"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen testtoon gedetecteerd van %@ – zet het harder en houd het stil"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wykryto dźwięku testowego z %@ – zwiększ głośność i zachowaj ciszę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum tom de teste detectado de %@ – aumente o volume e mantenha silêncio"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen testton hittades från %@ – höj volymen och håll rummet tyst"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не виявлено тестового сигналу від %@ – збільште гучність і зберігайте тишу"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到来自 %@ 的测试音 – 请调高音量并保持安静"
          }
        }
      }
    },
