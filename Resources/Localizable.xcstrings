    "%@ Click to try again.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Klikněte pro nový pokus."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Klik for at prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Klicke, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Click to try again."
          }
        },
        "es": {
