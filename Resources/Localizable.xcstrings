    "Plays a short test tone on each selected output and measures when it arrives": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehraje na každém vybraném výstupu krátký testovací tón a změří, kdy dorazí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspiller en kort testtone på hver valgt udgang og måler, hvornår den ankommer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt auf jeder gewählten Ausgabe einen kurzen Testton und misst, wann er ankommt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a short test tone on each selected output and measures when it arrives"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce un breve tono de prueba en cada salida elegida y mide cuándo llega"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soittaa lyhyen testiäänen jokaisesta valitusta ulostulosta ja mittaa, milloin se saapuu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue un court signal de test sur chaque sortie choisie et mesure quand il arrive"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce un breve tono di prova su ogni uscita selezionata e misura quando arriva"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した各出力で短いテストトーンを再生し、到達時間を測定します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 각 출력에서 짧은 테스트 톤을 재생하고 도달 시점을 측정합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiller av en kort testtone på hver valgte utgang og måler når den kommer frem"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt op elke gekozen uitvoer een korte testtoon af en meet wanneer die aankomt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarza krótki dźwięk testowy na każdym wybranym wyjściu i mierzy, kiedy dociera"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca um breve tom de teste em cada saída escolhida e mede quando ele chega"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelar en kort testton på varje vald utgång och mäter när den kommer fram"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворює короткий тестовий сигнал на кожному вибраному виході й вимірює, коли він надходить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个所选输出上播放短测试音，并测量其到达时间"
          }
        }
      }
    },
