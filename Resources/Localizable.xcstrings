          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den hämtade appen är inte signerad som den här – inte installerad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажену програму підписано не так, як цю – не встановлено."
