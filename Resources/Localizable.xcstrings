    "Select AudIO as sound output and tick at least two outputs first": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve vyberte AudIO jako zvukový výstup a zaškrtněte alespoň dva výstupy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg først AudIO som lydudgang og mindst to udgange"
          }
        },
