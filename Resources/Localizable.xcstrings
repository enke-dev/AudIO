    "Adds “AudIO” as a sound output – asks for your password": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá „AudIO“ jako zvukový výstup – vyžádá si heslo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføjer “AudIO” som lydudgang – beder om din adgangskode"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt „AudIO“ als Tonausgabe hinzu – fragt nach deinem Passwort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds “AudIO” as a sound output – asks for your password"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade “AudIO” como salida de sonido – pide tu contraseña"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää ”AudIO”:n äänen ulostuloksi – kysyy salasanaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute « AudIO » comme sortie audio – demande votre mot de passe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge “AudIO” come uscita audio – richiede la password"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“AudIO”をサウンド出力として追加します – パスワードが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘AudIO’를 사운드 출력으로 추가합니다 – 암호가 필요합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legger til «AudIO» som lydutgang – ber om passordet ditt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt ‘AudIO’ toe als geluidsuitvoer – vraagt om je wachtwoord"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje „AudIO” jako wyjście dźwięku – wymaga hasła"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona “AudIO” como saída de som – pede sua senha"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger till ”AudIO” som ljudutgång – ber om ditt lösenord"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає «AudIO» як аудіовихід – потрібен пароль"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“AudIO”添加为声音输出 – 需要输入密码"
          }
        }
      }
    },
