    "Measuring for about %lld s – keep the room quiet": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měří se asi %lld s – udržujte v místnosti ticho"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Måler i cirka %lld s – hold rummet stille"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messung dauert etwa %lld s – bitte leise sein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measuring for about %lld s – keep the room quiet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Midiendo durante unos %lld s – mantén la habitación en silencio"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitataan noin %lld s – pidä huone hiljaisena"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure pendant environ %lld s – gardez la pièce silencieuse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misurazione per circa %lld s – mantieni silenzio nella stanza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約%lld秒間測定します – 静かにしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %lld초 동안 측정합니다 – 조용히 해 주십시오"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Måler i omtrent %lld s – hold rommet stille"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meten duurt ongeveer %lld s – houd het stil in de ruimte"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomiar trwa ok. %lld s – zachowaj ciszę w pomieszczeniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Medindo por cerca de %lld s – mantenha o ambiente em silêncio"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mäter i cirka %lld s – håll rummet tyst"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимірювання триває близько %lld с – зберігайте тишу"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在测量，约 %lld 秒 – 请保持安静"
          }
        }
      }
    },
    "Microphone access denied – allow AudIO in Privacy & Security › Microphone": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup k mikrofonu odepřen – povolte AudIO v Soukromí a zabezpečení › Mikrofon"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til mikrofonen nægtet – tillad AudIO under Anonymitet og sikkerhed › Mikrofon"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonzugriff verweigert – erlaube AudIO unter „Datenschutz & Sicherheit“ › „Mikrofon“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access denied – allow AudIO in Privacy & Security › Microphone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso al micrófono denegado – permite AudIO en Privacidad y seguridad › Micrófono"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonin käyttö estetty – salli AudIO kohdassa Yksityisyys ja suojaus › Mikrofoni"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès au micro refusé – autorisez AudIO dans Confidentialité et sécurité › Micro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso al microfono negato – consenti AudIO in Privacy e sicurezza › Microfono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスが拒否されました – “プライバシーとセキュリティ” › “マイク”でAudIOを許可してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근이 거부되었습니다 – 개인정보 보호 및 보안 › 마이크에서 AudIO를 허용하십시오"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgang til mikrofonen avslått – tillat AudIO under Personvern og sikkerhet › Mikrofon"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot microfoon geweigerd – sta AudIO toe bij Privacy en beveiliging › Microfoon"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępu do mikrofonu – zezwól AudIO w Prywatność i ochrona › Mikrofon"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso ao microfone negado – permita o AudIO em Privacidade e Segurança › Microfone"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst till mikrofonen nekad – tillåt AudIO under Integritet och säkerhet › Mikrofon"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до мікрофона заборонено – дозвольте AudIO в «Приватність і безпека» › «Мікрофон»"
          }
        },
        "zh-Hans": {
